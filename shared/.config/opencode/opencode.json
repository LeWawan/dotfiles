{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-with-claude"],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    }
  },
  "mcp": {
    "godot": {
      "type": "local",
      "command": [
        "npx",
        "@coding-solo/godot-mcp"
      ],
      "environment": {
        "GODOT_PATH": "/usr/bin/godot"
      }
    }
  }
}
